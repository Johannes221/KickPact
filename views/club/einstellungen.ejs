<%- include('../partials/header', { title: 'Vereinseinstellungen' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container page-narrow">
    <h1 class="page-title">Vereinseinstellungen</h1>

    <% if (typeof query !== 'undefined' && query?.success) { %>
      <div class="alert alert-success">Änderungen gespeichert!</div>
    <% } %>

    <% if (!club) { %>
      <div class="alert alert-warning">Kein Verein zugeordnet. Bitte registriere zuerst einen Verein.</div>
    <% } else { %>
      <form action="/club/einstellungen" method="POST" class="card form-card">
        <h2>Vereinsdaten</h2>
        <div class="form-group">
          <label>Vereinsname</label>
          <input type="text" name="name" value="<%= club.name %>" class="form-input" required>
        </div>
        <div class="form-group">
          <label>fußball.de URL</label>
          <input type="url" name="fussballDeUrl" value="<%= club.fussballDeUrl || '' %>" class="form-input" placeholder="https://www.fussball.de/verein/...">
        </div>
        <div class="form-group">
          <label>fußball.de Vereins-ID</label>
          <input type="text" name="vereinId" value="<%= club.vereinId || '' %>" class="form-input" placeholder="z.B. 00ES8GN9OG000000...">
        </div>
        <div class="form-group">
          <label>Adresse</label>
          <input type="text" name="adresse" value="<%= club.adresse || '' %>" class="form-input" placeholder="Musterstraße 1, 69198 Schriesheim">
        </div>

        <h2>Gemeinnützigkeit</h2>
        <div class="form-group checkbox-group">
          <label>
            <input type="checkbox" name="isNonProfit" value="1" <%= club.isNonProfit ? 'checked' : '' %>>
            Gemeinnütziger Verein (e.V. mit Freistellungsbescheid)
          </label>
        </div>
        <div class="form-group">
          <label>Steuernummer</label>
          <input type="text" name="steuernummer" value="<%= club.steuernummer || '' %>" class="form-input" placeholder="12/345/67890">
        </div>
        <div class="form-group">
          <label>Freistellungsbescheid vom</label>
          <input type="text" name="freistellungDatum" value="<%= club.freistellungDatum || '' %>" class="form-input" placeholder="01.03.2024">
        </div>

        <button type="submit" class="btn btn-primary">Speichern</button>
      </form>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
