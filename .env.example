# Database
DATABASE_URL="postgresql://user:pass@host.neon.tech/kickpact?sslmode=require"

# Better Auth (Phase: Plan 2)
BETTER_AUTH_SECRET="generate via: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign in with Apple — https://developer.apple.com/account/resources
# APPLE_CLIENT_ID = Services-ID (z.B. "com.kickpact.web.auth")
# APPLE_CLIENT_SECRET = signiertes JWT, generiert aus .p8-Key (siehe scripts/apple-client-secret.ts)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Stripe (Plan 5)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASIC_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# Resend (Plan 2)
# WICHTIG: MAIL_FROM muss eine verifizierte Domain bei Resend nutzen, sonst
# kann nur an die Account-Email gesendet werden (Sandbox-Limit).
RESEND_API_KEY=""
MAIL_FROM="KickPact <noreply@kickpact.com>"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
