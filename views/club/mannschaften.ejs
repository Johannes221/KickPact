<%- include('../partials/header', { title: 'Mannschaften' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <div class="page-header">
      <h1 class="page-title">Mannschaften</h1>
    </div>

    <div class="card">
      <h2>Mannschaft importieren</h2>
      <p>Suche deinen Verein auf fußball.de und importiere deine Mannschaften automatisch.</p>
      <div class="search-box">
        <input type="text" id="import-search" placeholder="Vereinsname suchen..." class="search-input">
        <button onclick="searchForImport()" class="btn btn-primary">Suchen</button>
      </div>
      <div id="import-results"></div>
    </div>

    <div class="card">
      <h2>Deine Mannschaften</h2>
      <% if (teams.length === 0) { %>
        <div class="empty-state">Noch keine Mannschaften. Importiere oben deine erste Mannschaft.</div>
      <% } else { %>
        <div class="teams-manage-list">
          <% teams.forEach(t => { %>
            <div class="team-manage-row">
              <div class="team-manage-info">
                <strong><%= t.name %></strong>
                <span class="team-manage-meta">Saison <%= t.saison %> · ID: <%= t.fussballDeTeamId || '–' %></span>
                <% if (t.lastCrawled) { %>
                  <span class="team-manage-crawled">Letzter Crawl: <%= new Date(t.lastCrawled).toLocaleString('de-DE') %></span>
                <% } %>
              </div>
              <div class="team-manage-actions">
                <button onclick="triggerCrawl('<%= t._id %>')" class="btn btn-outline btn-sm">🔄 Jetzt crawlen</button>
                <a href="/club/mannschaft/<%= t._id %>" class="btn btn-outline btn-sm">Details</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
async function searchForImport() {
  const q = document.getElementById('import-search').value.trim();
  if (!q) return;
  const res = await fetch(`/api/crawler/search?q=${encodeURIComponent(q)}`);
  const data = await res.json();
  const el = document.getElementById('import-results');
  if (!data.length) { el.innerHTML = '<p class="empty-small">Keine Ergebnisse.</p>'; return; }
  el.innerHTML = data.map(v => `
    <div class="search-result-item">
      <strong>${v.name}</strong>
      <button onclick="loadTeamsForImport('${v.vereinId}', '${v.slug}', this)" class="btn btn-sm btn-outline">Mannschaften laden</button>
      <div class="import-teams-list" id="teams-${v.vereinId}"></div>
    </div>
  `).join('');
}

async function loadTeamsForImport(vereinId, slug, btn) {
  btn.disabled = true; btn.textContent = 'Lade...';
  const res = await fetch(`/api/crawler/teams?vereinId=${vereinId}&slug=${slug}`);
  const teams = await res.json();
  const el = document.getElementById('teams-' + vereinId);
  if (!teams.length) { el.innerHTML = '<p class="empty-small">Keine Mannschaften gefunden.</p>'; return; }
  el.innerHTML = teams.map(t => `
    <div class="import-team-row">
      <span>${t.name} (Saison ${t.saison.slice(0,2)}/20${t.saison.slice(2)})</span>
      <button onclick="importTeam(${JSON.stringify(t).replace(/"/g, '&quot;')})" class="btn btn-sm btn-primary">Importieren</button>
    </div>
  `).join('');
}

async function importTeam(team) {
  const res = await fetch('/api/teams/import', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(team),
  });
  if (res.ok) { alert('Mannschaft importiert!'); window.location.reload(); }
  else { const d = await res.json(); alert(d.error || 'Fehler'); }
}

async function triggerCrawl(teamId) {
  const res = await fetch('/api/crawler/crawl-team', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ teamId }),
  });
  if (res.ok) alert('Crawl gestartet! Läuft im Hintergrund.');
  else alert('Fehler beim Starten des Crawls.');
}
</script>

<%- include('../partials/footer') %>
