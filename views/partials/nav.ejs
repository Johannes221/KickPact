<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <span class="brand-icon">⚽</span>
      <span class="brand-text">KickPact</span>
    </a>
    <div class="nav-links">
      <% if (user) { %>
        <% if (user.role === 'sponsor') { %>
          <a href="/sponsor/dashboard" class="nav-link">Dashboard</a>
          <a href="/sponsor/pledges" class="nav-link">Pledges</a>
          <a href="/sponsor/rechnungen" class="nav-link">Rechnungen</a>
        <% } else if (user.role === 'club_admin' || user.role === 'team_admin' || user.role === 'super_admin') { %>
          <a href="/club/dashboard" class="nav-link">Dashboard</a>
          <a href="/club/mannschaften" class="nav-link">Mannschaften</a>
          <a href="/club/einnahmen" class="nav-link">Einnahmen</a>
        <% } %>
        <div class="nav-user">
          <span class="nav-username"><%= user.name %></span>
          <a href="/logout" class="btn btn-outline btn-sm">Abmelden</a>
        </div>
      <% } else { %>
        <a href="/login" class="nav-link">Anmelden</a>
        <a href="/registrieren" class="btn btn-primary btn-sm">Kostenlos starten</a>
      <% } %>
    </div>
    <button class="nav-toggle" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
  </div>
</nav>
