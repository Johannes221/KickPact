<%- include('../partials/header', { title: team.name }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <div class="breadcrumb">
      <a href="/verein/<%= club.slug %>"><%= club.name %></a> › <span><%= team.name %></span>
    </div>

    <div class="team-header">
      <h1 class="page-title">👕 <%= team.name %></h1>
      <p class="team-meta"><%= pledgeCount %> aktive Sponsoren · Saison <%= team.saison.slice(0,2) %>/20<%= team.saison.slice(2) %></p>
    </div>

    <div class="team-grid">
      <div class="team-main">
        <h2 class="section-heading">Letzte Ergebnisse</h2>
        <% if (matches.length === 0) { %>
          <div class="empty-state">Noch keine Spiele gecrawlt.</div>
        <% } else { %>
          <div class="matches-list">
            <% matches.forEach(m => { %>
              <div class="match-row">
                <span class="match-date"><%= m.datum %></span>
                <span class="match-teams"><%= m.heim %> vs. <%= m.gast %></span>
                <% if (m.ergebnis) { %>
                  <span class="match-score <%= m.kickpactTrigger && m.kickpactTrigger.sieg ? 'score-win' : m.kickpactTrigger && m.kickpactTrigger.niederlage ? 'score-loss' : 'score-draw' %>">
                    <%= m.ergebnis.heim %>:<%= m.ergebnis.gast %>
                  </span>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="team-sidebar">
        <div class="sidebar-card">
          <h3>🏅 Torjägerliste</h3>
          <% if (torjaeger.length === 0) { %>
            <p class="empty-small">Noch keine Daten.</p>
          <% } else { %>
            <ol class="torjaeger-list">
              <% torjaeger.forEach((t, i) => { %>
                <li class="torjaeger-item">
                  <span class="torjaeger-rank"><%= i + 1 %>.</span>
                  <span class="torjaeger-name"><%= t.name %></span>
                  <span class="torjaeger-goals"><%= t.tore %> ⚽</span>
                </li>
              <% }) %>
            </ol>
          <% } %>
        </div>

        <div class="sidebar-cta">
          <h3>Sponsor werden</h3>
          <p>Sponsere Tore, Siege oder deinen Lieblingsspieler.</p>
          <a href="/registrieren" class="btn btn-primary btn-full">Jetzt starten</a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
