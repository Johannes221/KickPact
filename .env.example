# Database
DATABASE_URL="postgresql://user:pass@host.neon.tech/kickpact?sslmode=require"

# Test-Datenbank (PFLICHT für `npm test`). Tests/resetTestDb löschen ALLE
# Tabellen — ohne diese Variable würde das gegen die obige (geteilte Neon-)DB
# laufen und Staging-Daten wipen. Daher zeigt sie auf eine ISOLIERTE lokale DB:
#   docker compose -f docker-compose.test.yml up -d
# resetTestDb verweigert den Lauf, wenn diese Var fehlt oder auf Neon zeigt.
DATABASE_URL_TEST="postgres://test:test@localhost:54329/kickpact_test"

# Better Auth (Phase: Plan 2)
# Wird zusätzlich von lib/auth/opt-out-token.ts als HMAC-Secret für signed
# Spieler-Opt-out-Links (/spieler-opt-out?token=…) genutzt.
BETTER_AUTH_SECRET="generate via: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple "Sign in with Apple" — siehe docs/oauth-setup.md
# Workflow: scripts/generate-apple-jwt.mjs signiert ein ES256-JWT aus den unteren
# vier Werten. Output kommt als APPLE_CLIENT_SECRET in die ENV. Rotation alle 5 Monate.
APPLE_CLIENT_ID=""        # Services-ID, z.B. "com.kickpact.web.auth"
APPLE_CLIENT_SECRET=""    # vor-signiertes JWT (max ~6 Monate gültig)
APPLE_BUNDLE_ID=""        # optional: Native iOS-App Bundle-Identifier
# Signing-Inputs (nur für scripts/generate-apple-jwt.mjs benötigt):
APPLE_TEAM_ID=""          # 10-stelliger Team-Identifier (Apple Dev Portal → Membership)
APPLE_KEY_ID=""           # 10-stellige Key-ID des erzeugten "Sign in with Apple"-Keys
APPLE_PRIVATE_KEY=""      # Inhalt der .p8-Datei (Multiline ODER mit \n escaped)

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# APNs — native iOS-Push (NUR App, kein Web-Push). Siehe Spec
# docs/superpowers/specs/2026-06-02-ios-push-notifications.md.
# Fehlen diese Werte, ist der Push-Versand ein No-Op (kein Crash) — die App
# läuft, es werden nur keine nativen Mitteilungen verschickt.
APNS_KEY_ID=""                 # 10-stellige Key-ID des APNs Auth Keys (.p8)
APNS_TEAM_ID="A5SM7VJ6M2"      # Apple Developer Team-ID
APNS_BUNDLE_ID="com.kickpact.app"  # wird als apns-topic gesendet
APNS_PRIVATE_KEY=""            # Inhalt der .p8-Datei (Multiline ODER mit \n escaped)
APNS_PRODUCTION="false"        # "true" → api.push.apple.com; sonst Sandbox (TestFlight/Dev)

# Stripe (Plan 5) — siehe docs/stripe-setup.md
# Skeleton ist im Repo aktiv; ohne Keys läuft die App, nur Checkout-Buttons sind
# disabled. Sobald Keys + Price-IDs gesetzt sind, wird Stripe Checkout + Webhook live.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# 6 Price-IDs: 3 Tiers × 2 Billing-Cycles (siehe docs/pricing.md)
# Pattern: STRIPE_<BASIC|PRO|VEREIN>_<MONTHLY|SEASON_END>_PRICE_ID
# (Cycle-Key folgt exakt dem DB-Enum billing_cycle → "season_end", nicht "season".
#  Der frühere "annual"-Cycle wurde 2026-06-02 entfernt — Saison-Pass = Jahres-Bindung.)
STRIPE_BASIC_MONTHLY_PRICE_ID=""       # Basic, 5 €/Mannschaft/Monat
STRIPE_BASIC_SEASON_END_PRICE_ID=""    # Basic, 39 €/Saison-Pass (Aug–Mai, year recurring)
STRIPE_PRO_MONTHLY_PRICE_ID=""         # Pro, 19 €/Mannschaft/Monat
STRIPE_PRO_SEASON_END_PRICE_ID=""      # Pro, 149 €/Saison-Pass
STRIPE_VEREIN_MONTHLY_PRICE_ID=""      # Vereinslizenz, 49 €/Verein/Monat
STRIPE_VEREIN_SEASON_END_PRICE_ID=""   # Vereinslizenz, 389 €/Saison-Pass

# Resend (Plan 2)
# WICHTIG: MAIL_FROM muss eine verifizierte Domain bei Resend nutzen, sonst
# kann nur an die Account-Email gesendet werden (Sandbox-Limit).
RESEND_API_KEY=""
MAIL_FROM="KickPact <noreply@kickpact.com>"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# SEO / Robots: "production" → Sitemap + robots allow indexing.
# Alles andere (leer, "staging", "development") → noindex für alle Bots.
# Staging Coolify: NEXT_PUBLIC_SITE_ENV=staging
# Production Coolify: NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_SITE_ENV=

# Analytics (Plausible) — optional, leer = kein Tracking
# Domain wie in Plausible eingetragen (z.B. "kickpact.de"). Wenn nicht gesetzt,
# wird das Plausible-Snippet nicht geladen und alle track()-Calls sind No-ops.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=kickpact.de
# Optional: alternative Script-URL für self-hosted Plausible (z.B.
# "https://analytics.kickpact.de/js/script.js"). Default: plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# Server-side Events (Stripe Webhook → Plausible POST /api/event). Hole den
# Key aus plausible.io/<domain>/settings/api. Aktuell verwendet die
# trackServer()-Implementierung keinen API-Key — diese Variable ist für
# zukünftige Funktionen vorgesehen, die das Plausible Stats API benötigen.
PLAUSIBLE_API_KEY=

# Sentry — https://kickpact.sentry.io
# 1. Projekt anlegen: https://kickpact.sentry.io/projects/new/ (Plattform: Next.js)
# 2. DSN aus "Settings → Projects → kickpact → Client Keys (DSN)" kopieren
# 3. SENTRY_DSN + NEXT_PUBLIC_SENTRY_DSN auf denselben Wert setzen
#    (server- vs. client-Bundle brauchen unterschiedliche env-Prefixe)
# 4. SENTRY_AUTH_TOKEN für source-map upload: Settings → Auth Tokens → "Create New Token"
#    Scopes: project:releases, org:read, project:read
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=kickpact
SENTRY_PROJECT=kickpact
# Optional: separate Sentry-Environments für Preview/Branches setzen, sonst NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Nur in CI/Build-Pipelines setzen (für source-map upload). Niemals committen.
SENTRY_AUTH_TOKEN=
