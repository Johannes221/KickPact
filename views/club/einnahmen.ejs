<%- include('../partials/header', { title: 'Einnahmen' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <div class="page-header">
      <h1 class="page-title">Einnahmen</h1>
    </div>

    <%
      const totalNetto = charges.filter(c => c.status === 'charged').reduce((s, c) => s + c.nettoVereinCent, 0);
      const totalPending = charges.filter(c => c.status === 'pending').reduce((s, c) => s + c.gesamtCent, 0);
    %>

    <div class="stats-row">
      <div class="stat-card stat-card-green">
        <div class="stat-card-value"><%= (totalNetto / 100).toFixed(2).replace('.', ',') %>€</div>
        <div class="stat-card-label">Gesamt ausgezahlt (Netto)</div>
      </div>
      <div class="stat-card stat-card-yellow">
        <div class="stat-card-value"><%= (totalPending / 100).toFixed(2).replace('.', ',') %>€</div>
        <div class="stat-card-label">Ausstehend nächste Abrechnung</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>Alle Abrechnungen</h2>
        <button onclick="exportCSV()" class="btn btn-outline btn-sm">⬇ CSV Export</button>
      </div>

      <% if (charges.length === 0) { %>
        <div class="empty-state">Noch keine Abrechnungen.</div>
      <% } else { %>
        <table class="data-table" id="charges-table">
          <thead>
            <tr><th>Monat</th><th>Sponsor</th><th>Mannschaft</th><th>Brutto</th><th>Provision (3%)</th><th>Netto</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% charges.forEach(c => { %>
              <tr>
                <td><%= c.monat %></td>
                <td><%= c.sponsorId?.name || '-' %></td>
                <td><%= c.teamId?.name || '-' %></td>
                <td><%= (c.gesamtCent / 100).toFixed(2).replace('.', ',') %>€</td>
                <td><%= (c.provisionCent / 100).toFixed(2).replace('.', ',') %>€</td>
                <td><strong><%= (c.nettoVereinCent / 100).toFixed(2).replace('.', ',') %>€</strong></td>
                <td><span class="badge badge-<%= c.status === 'charged' ? 'green' : c.status === 'failed' ? 'red' : 'yellow' %>"><%= c.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</main>

<script>
function exportCSV() {
  const rows = [['Monat', 'Sponsor', 'Mannschaft', 'Brutto', 'Provision', 'Netto', 'Status']];
  document.querySelectorAll('#charges-table tbody tr').forEach(row => {
    rows.push([...row.querySelectorAll('td')].map(td => td.textContent.trim()));
  });
  const csv = rows.map(r => r.join(';')).join('\n');
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
  a.download = 'kickpact-einnahmen.csv';
  a.click();
}
</script>

<%- include('../partials/footer') %>
