<%- include('../partials/header', { title: 'Anmelden' }) %>
<%- include('../partials/nav') %>

<main class="auth-page">
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-logo">⚽ KickPact</div>
      <h1 class="auth-title">Willkommen zurück</h1>
      <p class="auth-subtitle">Melde dich mit deinem Konto an</p>

      <div id="error-msg" class="alert alert-error" style="display:none"></div>

      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="email" placeholder="deine@email.de" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password">Passwort</label>
          <input type="password" id="password" name="password" placeholder="Dein Passwort" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-full" id="submit-btn">Anmelden</button>
      </form>

      <p class="auth-footer">Noch kein Konto? <a href="/registrieren">Jetzt registrieren</a></p>
    </div>
  </div>
</main>

<script>
document.getElementById('login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  const errEl = document.getElementById('error-msg');
  btn.disabled = true;
  btn.textContent = 'Anmelden...';
  errEl.style.display = 'none';

  const res = await fetch('/api/auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      email: document.getElementById('email').value,
      password: document.getElementById('password').value,
    }),
  });
  const data = await res.json();

  if (res.ok) {
    const role = data.user.role;
    if (role === 'sponsor') window.location.href = '/sponsor/dashboard';
    else window.location.href = '/club/dashboard';
  } else {
    errEl.textContent = data.error || 'Fehler beim Anmelden';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Anmelden';
  }
});
</script>

<%- include('../partials/footer') %>
