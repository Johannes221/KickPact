<%- include('../partials/header', { title: 'Registrieren' }) %>
<%- include('../partials/nav') %>

<main class="auth-page">
  <div class="auth-container">
    <div class="auth-card auth-card-wide">
      <div class="auth-logo">⚽ KickPact</div>
      <h1 class="auth-title">Konto erstellen</h1>

      <div class="role-tabs">
        <button class="role-tab active" data-role="sponsor" onclick="setRole('sponsor', this)">
          💚 Ich bin Sponsor
        </button>
        <button class="role-tab" data-role="club_admin" onclick="setRole('club_admin', this)">
          🏟️ Ich verwalte einen Verein
        </button>
      </div>

      <div id="error-msg" class="alert alert-error" style="display:none"></div>

      <form id="register-form" class="auth-form">
        <input type="hidden" id="role" name="role" value="sponsor">

        <div class="form-row">
          <div class="form-group">
            <label for="name">Vollständiger Name</label>
            <input type="text" id="name" name="name" placeholder="Max Mustermann" required>
          </div>
          <div class="form-group">
            <label for="email">E-Mail</label>
            <input type="email" id="email" name="email" placeholder="deine@email.de" required>
          </div>
        </div>

        <div class="form-group">
          <label for="password">Passwort <span class="hint">(mind. 8 Zeichen)</span></label>
          <input type="password" id="password" name="password" placeholder="Sicheres Passwort" required minlength="8">
        </div>

        <div id="club-fields" style="display:none">
          <div class="form-divider">Vereinsinformationen</div>
          <div class="form-group">
            <label for="clubName">Vereinsname</label>
            <input type="text" id="clubName" name="clubName" placeholder="z.B. SV Schriesheim 1969 e.V.">
          </div>
          <div class="form-group">
            <label for="fussballDeUrl">fußball.de Vereinsseite <span class="hint">(optional)</span></label>
            <input type="url" id="fussballDeUrl" name="fussballDeUrl" placeholder="https://www.fussball.de/verein/...">
          </div>
          <div class="form-group">
            <label for="vereinId">fußball.de Vereins-ID <span class="hint">(optional)</span></label>
            <input type="text" id="vereinId" name="vereinId" placeholder="z.B. 00ES8GN9OG000000VS548898VUVCRLMK">
          </div>
        </div>

        <div class="form-group checkbox-group">
          <label>
            <input type="checkbox" required>
            Ich akzeptiere die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-full" id="submit-btn">Konto erstellen</button>
      </form>

      <p class="auth-footer">Bereits registriert? <a href="/login">Jetzt anmelden</a></p>
    </div>
  </div>
</main>

<script>
function setRole(role, el) {
  document.getElementById('role').value = role;
  document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('club-fields').style.display = role === 'club_admin' ? 'block' : 'none';
}

const urlParams = new URLSearchParams(window.location.search);
if (urlParams.get('role') === 'club_admin') {
  setRole('club_admin', document.querySelector('[data-role="club_admin"]'));
}

document.getElementById('register-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('submit-btn');
  const errEl = document.getElementById('error-msg');
  btn.disabled = true;
  btn.textContent = 'Registrieren...';
  errEl.style.display = 'none';

  const body = {
    name: document.getElementById('name').value,
    email: document.getElementById('email').value,
    password: document.getElementById('password').value,
    role: document.getElementById('role').value,
    clubName: document.getElementById('clubName')?.value || undefined,
    fussballDeUrl: document.getElementById('fussballDeUrl')?.value || undefined,
    vereinId: document.getElementById('vereinId')?.value || undefined,
  };

  const res = await fetch('/api/auth/register', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json();

  if (res.ok) {
    const role = data.user.role;
    if (role === 'sponsor') window.location.href = '/sponsor/pledge/neu';
    else window.location.href = '/club/dashboard';
  } else {
    errEl.textContent = data.error || 'Fehler bei der Registrierung';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Konto erstellen';
  }
});
</script>

<%- include('../partials/footer') %>
