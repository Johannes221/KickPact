<%- include('../partials/header', { title: 'Sponsoren' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <h1 class="page-title">Aktive Sponsoren</h1>
    <p class="page-subtitle"><%= sponsoren.length %> Sponsoren unterstützen deinen Verein</p>

    <% if (sponsoren.length === 0) { %>
      <div class="empty-state-large">
        <div class="empty-icon">👥</div>
        <h2>Noch keine Sponsoren</h2>
        <p>Sobald sich Sponsoren für deine Mannschaften registrieren, erscheinen sie hier.</p>
      </div>
    <% } else { %>
      <div class="card">
        <table class="data-table">
          <thead>
            <tr><th>Name</th><th>E-Mail</th><th>Mannschaften</th><th>Aktive Pledges</th></tr>
          </thead>
          <tbody>
            <% sponsoren.forEach(s => { %>
              <tr>
                <td><strong><%= s.sponsor.name %></strong></td>
                <td><%= s.sponsor.email %></td>
                <td><%= [...new Set(s.teams.filter(Boolean))].join(', ') %></td>
                <td><%= s.pledges.length %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
