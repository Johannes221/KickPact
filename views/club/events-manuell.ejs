<%- include('../partials/header', { title: 'Manuelle Events' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <div class="page-header">
      <h1 class="page-title">Manuelle Events</h1>
    </div>

    <div id="msg" class="alert" style="display:none"></div>

    <% if (events.length === 0) { %>
      <div class="empty-state-large">
        <div class="empty-icon">✅</div>
        <h2>Keine Events ausstehend</h2>
        <p>Alle manuellen Events wurden bearbeitet.</p>
      </div>
    <% } else { %>
      <div class="events-list">
        <% events.forEach(ev => { %>
          <div class="manual-event-card" id="event-<%= ev._id %>">
            <div class="event-card-header">
              <span class="event-type-badge"><%= ev.typ %></span>
              <span class="event-team">📍 <%= ev.teamId?.name %></span>
              <span class="badge badge-<%= ev.status === 'approved' ? 'green' : ev.status === 'rejected' ? 'red' : 'yellow' %>"><%= ev.status %></span>
              <span class="event-date"><%= new Date(ev.createdAt).toLocaleDateString('de-DE') %></span>
            </div>
            <div class="event-card-body">
              <% if (ev.spielerName) { %><p>Spieler: <strong><%= ev.spielerName %></strong></p><% } %>
              <% if (ev.minute) { %><p>Minute: <strong><%= ev.minute %>'</strong></p><% } %>
              <p class="text-muted">Eingetragen von: <%= ev.eingetragenVon?.name || 'Unbekannt' %></p>
            </div>
            <% if (ev.status === 'pending') { %>
              <div class="event-card-actions">
                <button onclick="approveEvent('<%= ev._id %>')" class="btn btn-primary btn-sm">✅ Freigeben</button>
                <button onclick="rejectEvent('<%= ev._id %>')" class="btn btn-danger btn-sm">❌ Ablehnen</button>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<script>
async function approveEvent(id) {
  const res = await fetch(`/api/manual-events/${id}/approve`, { method: 'PUT' });
  if (res.ok) { window.location.reload(); }
  else { alert('Fehler beim Freigeben.'); }
}

async function rejectEvent(id) {
  if (!confirm('Event wirklich ablehnen?')) return;
  const res = await fetch(`/api/manual-events/${id}/reject`, { method: 'PUT' });
  if (res.ok) { window.location.reload(); }
  else { alert('Fehler beim Ablehnen.'); }
}
</script>

<%- include('../partials/footer') %>
