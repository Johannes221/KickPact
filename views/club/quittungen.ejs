<%- include('../partials/header', { title: 'Spendenquittungen' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <h1 class="page-title">Spendenquittungen</h1>

    <% if (!club || !club.isNonProfit) { %>
      <div class="alert alert-warning">
        <strong>Spendenquittungen nur für gemeinnützige Vereine.</strong>
        <p>Bitte hinterlege in den <a href="/club/einstellungen">Einstellungen</a> deinen Freistellungsbescheid.</p>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        <strong>Verein:</strong> <%= club.name %> ·
        <strong>Steuernummer:</strong> <%= club.steuernummer || '–' %> ·
        <strong>Freistellungsbescheid:</strong> <%= club.freistellungDatum || '–' %>
      </div>

      <div class="card">
        <h2>Abrechnungen</h2>
        <% if (charges.length === 0) { %>
          <div class="empty-state">Noch keine abgerechneten Charges.</div>
        <% } else { %>
          <table class="data-table">
            <thead><tr><th>Monat</th><th>Sponsor</th><th>Betrag</th><th>Quittung</th></tr></thead>
            <tbody>
              <% charges.forEach(c => { %>
                <tr>
                  <td><%= c.monat %></td>
                  <td><%= c.sponsorId?.name %> (<%= c.sponsorId?.email %>)</td>
                  <td><strong><%= (c.gesamtCent / 100).toFixed(2).replace('.', ',') %>€</strong></td>
                  <td>
                    <a href="/api/charges/quittung/<%= c._id %>" target="_blank" class="btn btn-outline btn-sm">
                      📄 PDF Download
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
