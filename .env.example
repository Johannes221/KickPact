# Database
DATABASE_URL="postgresql://user:pass@host.neon.tech/kickpact?sslmode=require"

# Test-Datenbank (PFLICHT für `npm test`). Tests/resetTestDb löschen ALLE
# Tabellen — ohne diese Variable würde das gegen die obige (geteilte Neon-)DB
# laufen und Staging-Daten wipen. Daher zeigt sie auf eine ISOLIERTE lokale DB:
#   docker compose -f docker-compose.test.yml up -d
# resetTestDb verweigert den Lauf, wenn diese Var fehlt oder auf Neon zeigt.
DATABASE_URL_TEST="postgres://test:test@localhost:54329/kickpact_test"

# Better Auth (Phase: Plan 2)
# Wird zusätzlich von lib/auth/opt-out-token.ts als HMAC-Secret für signed
# Spieler-Opt-out-Links (/spieler-opt-out?token=…) genutzt.
BETTER_AUTH_SECRET="generate via: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple "Sign in with Apple" — siehe docs/oauth-setup.md
# Workflow: scripts/generate-apple-jwt.mjs signiert ein ES256-JWT aus den unteren
# vier Werten. Output kommt als APPLE_CLIENT_SECRET in die ENV. Rotation alle 5 Monate.
APPLE_CLIENT_ID=""        # Services-ID, z.B. "com.kickpact.web.auth"
APPLE_CLIENT_SECRET=""    # vor-signiertes JWT (max ~6 Monate gültig)
APPLE_BUNDLE_ID=""        # optional: Native iOS-App Bundle-Identifier
# Signing-Inputs (nur für scripts/generate-apple-jwt.mjs benötigt):
APPLE_TEAM_ID=""          # 10-stelliger Team-Identifier (Apple Dev Portal → Membership)
APPLE_KEY_ID=""           # 10-stellige Key-ID des erzeugten "Sign in with Apple"-Keys
APPLE_PRIVATE_KEY=""      # Inhalt der .p8-Datei (Multiline ODER mit \n escaped)

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# APNs — native iOS-Push (NUR App, kein Web-Push). Siehe Spec
# docs/superpowers/specs/2026-06-02-ios-push-notifications.md.
# Fehlen diese Werte, ist der Push-Versand ein No-Op (kein Crash) — die App
# läuft, es werden nur keine nativen Mitteilungen verschickt.
APNS_KEY_ID=""                 # 10-stellige Key-ID des APNs Auth Keys (.p8)
APNS_TEAM_ID="A5SM7VJ6M2"      # Apple Developer Team-ID
APNS_BUNDLE_ID="com.kickpact.app"  # wird als apns-topic gesendet
APNS_PRIVATE_KEY=""            # Inhalt der .p8-Datei (Multiline ODER mit \n escaped)
APNS_PRODUCTION="false"        # "true" → api.push.apple.com; sonst Sandbox (TestFlight/Dev)

# Stripe (Plan 5) — siehe docs/stripe-setup.md
# Skeleton ist im Repo aktiv; ohne Keys läuft die App, nur Checkout-Buttons sind
# disabled. Sobald Keys + Price-IDs gesetzt sind, wird Stripe Checkout + Webhook live.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# 6 Price-IDs: 3 Tiers × 2 Billing-Cycles. Beträge = Source of Truth in
# lib/stripe/pricing.ts (docs/pricing.md). Stripe-Preise sind UNVERÄNDERLICH —
# bei Preisänderung neue Price-Objekte anlegen + hier neu verknüpfen:
#   npm run stripe:prices          # legt sie an, gibt diese 6 Zeilen aus
#   npm run stripe:prices:verify   # prüft Betrag == pricing.ts (siehe docs/stripe-setup.md)
# Pattern: STRIPE_<BASIC|PRO|VEREIN>_<MONTHLY|SEASON_END>_PRICE_ID
# (Cycle-Key folgt exakt dem DB-Enum billing_cycle → "season_end", nicht "season".
#  Der frühere "annual"-Cycle wurde 2026-06-02 entfernt — Saison-Pass = Jahres-Bindung.)
STRIPE_BASIC_MONTHLY_PRICE_ID=""       # Basic, 5 €/Mannschaft/Monat
STRIPE_BASIC_SEASON_END_PRICE_ID=""    # Basic, 35 €/Saison-Pass (Aug–Mai, year recurring)
STRIPE_PRO_MONTHLY_PRICE_ID=""         # Pro, 11 €/Mannschaft/Monat
STRIPE_PRO_SEASON_END_PRICE_ID=""      # Pro, 75 €/Saison-Pass (year recurring)
STRIPE_VEREIN_MONTHLY_PRICE_ID=""      # Vereinslizenz, 29 €/Verein/Monat
STRIPE_VEREIN_SEASON_END_PRICE_ID=""   # Vereinslizenz, 199 €/Saison-Pass (year recurring)

# Resend (Plan 2)
# WICHTIG: MAIL_FROM muss eine verifizierte Domain bei Resend nutzen, sonst
# kann nur an die Account-Email gesendet werden (Sandbox-Limit).
RESEND_API_KEY=""
MAIL_FROM="KickPact <noreply@kickpact.com>"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# SEO / Robots: "production" → Sitemap + robots allow indexing.
# Alles andere (leer, "staging", "development") → noindex für alle Bots.
# Staging Coolify: NEXT_PUBLIC_SITE_ENV=staging
# Production Coolify: NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_SITE_ENV=

# Analytics (Plausible, self-hosted auf analytics.schartl.dev)
# Domain wie in Plausible eingetragen = Production-Web-Domain.
# Default (wenn nicht gesetzt): "kickpact.com".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=kickpact.com
# Optional: alternative Script-URL überschreiben.
# Default: https://analytics.schartl.dev/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# Optional: Plausible-Host für Server-Side-Events (POST /api/event).
# Default: https://analytics.schartl.dev
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Server-side Events (Stripe Webhook → Plausible POST /api/event). Hole den
# Key aus plausible.io/<domain>/settings/api. Aktuell verwendet die
# trackServer()-Implementierung keinen API-Key — diese Variable ist für
# zukünftige Funktionen vorgesehen, die das Plausible Stats API benötigen.
PLAUSIBLE_API_KEY=

# Meta-App-ID (developers.facebook.com → App anlegen, Typ egal, keine Review nötig).
# Öffentliche ID, kein Secret — wird als source_application ans
# instagram-stories://share-URL-Scheme gehängt (direktes Story-Teilen aus der
# iOS-App, Wrapped). Leer = Feature aus, Wrapped nutzt das generische Share-Sheet.
NEXT_PUBLIC_META_APP_ID=

# Sentry — https://kickpact.sentry.io
# 1. Projekt anlegen: https://kickpact.sentry.io/projects/new/ (Plattform: Next.js)
# 2. DSN aus "Settings → Projects → kickpact → Client Keys (DSN)" kopieren
# 3. SENTRY_DSN + NEXT_PUBLIC_SENTRY_DSN auf denselben Wert setzen
#    (server- vs. client-Bundle brauchen unterschiedliche env-Prefixe)
# 4. SENTRY_AUTH_TOKEN für source-map upload: Settings → Auth Tokens → "Create New Token"
#    Scopes: project:releases, org:read, project:read
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=kickpact
SENTRY_PROJECT=kickpact
# Optional: separate Sentry-Environments für Preview/Branches setzen, sonst NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Nur in CI/Build-Pipelines setzen (für source-map upload). Niemals committen.
SENTRY_AUTH_TOKEN=

# Dokumenten-/PDF-Storage (S3-kompatibel: Cloudflare R2 / Hetzner Object Storage)
# PROD-PFLICHT (EU-Jurisdiktion, DSGVO). Ohne R2 fällt der Storage auf ein lokales
# Volume zurück (DOC_STORAGE_PATH / PDF_STORAGE_PATH) bzw. /tmp im Dev — und Coolify
# ersetzt bei JEDEM Deploy den Container: ist das Volume nicht als *Persistent
# Volume* gemountet, sind danach ALLE Rechnungs-PDFs weg (local://-URLs zeigen ins
# Leere). In Prod daher R2 setzen oder Persistent-Volume + Single-Instance beweisen.
# Es werden BEIDE Schreibweisen gelesen:
# CLOUDFLARE_R2_* bevorzugt, R2_* als Fallback (lib/storage/documents.ts +
# lib/invoicing/storage.ts).
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=          # optional, sonst aus ACCOUNT_ID abgeleitet
CLOUDFLARE_R2_ACCOUNT_ID=        # nur nötig, wenn ENDPOINT nicht gesetzt ist
# Lokaler Fallback-Pfad (nur relevant ohne R2):
DOC_STORAGE_PATH=/data/kickpact-docs
PDF_STORAGE_PATH=/data/kickpact-pdfs

# E2E-Tests (Playwright) — app/api/test-auth/* (Session-Stub + Cleanup)
# SECURITY: Beide Vars NUR auf Staging setzen, NIEMALS auf kickpact.com
# (Production). Siehe DEPLOYMENT.md → "Test-Auth-Endpoints".
# Shared Secret zwischen Test-Runner und Server (Header x-test-bypass):
E2E_TEST_BYPASS_KEY=
# Production-Builds (auch Staging!) deaktivieren die Test-Auth-Endpoints hart,
# außer dieses Flag ist exakt "true":
ALLOW_TEST_AUTH=
# Ziel-URL für Playwright (Default: https://kickpact.schartl.dev):
PLAYWRIGHT_BASE_URL=

# Betrieb / Diagnose
# Empfänger der Drift-Alert-Mails aus dem verify-results-Inngest-Job. Ohne Wert
# wird nur geloggt, keine Mail versendet.
ADMIN_ALERT_EMAIL=
# "1" → ausführliche Crawler-Logs (lib/crawler/fussballde.ts). Default: aus.
CRAWL_DEBUG=
# "true" → deaktiviert das Sommerpause-Fenster (Crawler läuft auch Juni/Juli).
# Nützlich für CI / manuelle Re-Runs außerhalb der Saison.
SOMMERPAUSE_OVERRIDE_DISABLED=

# /status-Seite: ohne gültiges ?token=<STATUS_PAGE_TOKEN> liefert die Seite nur
# ein minimales "ok" (keine Tabellen-Counts/Interna). Leer = immer minimal.
# (Echter DB-Health-Check ist tokenfrei unter /api/health.)
STATUS_PAGE_TOKEN=

# Serverseitiges Rate-Limit (lib/utils/rate-limit.ts). Ohne REDIS_URL läuft das
# Limit nur IN-MEMORY pro Instanz (Reset bei jedem Deploy, bei Multi-Instance
# effektiv n×). Für Prod Redis setzen (Self-Hosted-Stack vorhanden).
REDIS_URL=

# --- Apple In-App-Purchase (nur iOS-App / IAP-Kanal; NICHT für Web-Launch) ---
# StoreKit-Kauf-Verifikation (lib/apple/verifier.ts) + App Store Server API
# (lib/apple/api-client.ts, Reconcile-Cron). Ohne diese Vars antwortet
# /api/apple/verify mit 503 → jeder iOS-Kauf schlägt NACH der Belastung fehl.
APPLE_IAP_BUNDLE_ID="com.kickpact.app"
APPLE_IAP_ENV="sandbox"            # "production" für Store-Build, sonst Sandbox
APPLE_IAP_APP_APPLE_ID=""          # numerische App-Apple-ID aus App Store Connect
APPLE_IAP_ROOT_CERTS=""            # Apple Root CA (G3) als base64-DER, kommagetrennt
APPLE_IAP_KEY_ID=""                # App Store Connect API Key-ID
APPLE_IAP_ISSUER_ID=""             # App Store Connect Issuer-ID
APPLE_IAP_PRIVATE_KEY=""           # Inhalt des ASC-API-.p8 (für Reconcile)

# Native iOS-Google-Login: Audience des iOS-idTokens (lib/auth/server.ts).
# = GoogleAuth.iosClientId in capacitor.config.ts. Ohne diese Var scheitert der
# native Google-Login in der App an Audience-Mismatch.
GOOGLE_IOS_CLIENT_ID=""
