<%- include('../partials/header', { title: 'Club Dashboard' }) %>
<%- include('../partials/nav') %>

<main class="dashboard-page">
  <div class="page-container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Club Dashboard</h1>
        <% if (club) { %>
          <p class="page-subtitle"><%= club.name %><% if (!club.isApproved) { %> · <span class="badge badge-yellow">Ausstehende Freigabe</span><% } %></p>
        <% } %>
      </div>
      <a href="/club/mannschaften" class="btn btn-primary">+ Mannschaft</a>
    </div>

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-card-icon">👕</div>
        <div class="stat-card-value"><%= teams.length %></div>
        <div class="stat-card-label">Mannschaften</div>
      </div>
      <div class="stat-card stat-card-green">
        <div class="stat-card-icon">💰</div>
        <div class="stat-card-value"><%= (einnahmenCent / 100).toFixed(2).replace('.', ',') %>€</div>
        <div class="stat-card-label">Einnahmen (Netto)</div>
      </div>
      <div class="stat-card stat-card-yellow">
        <div class="stat-card-icon">⏳</div>
        <div class="stat-card-value"><%= (ausstehendCent / 100).toFixed(2).replace('.', ',') %>€</div>
        <div class="stat-card-label">Ausstehend</div>
      </div>
      <div class="stat-card stat-card-orange">
        <div class="stat-card-icon">🔔</div>
        <div class="stat-card-value"><%= pendingEvents.length %></div>
        <div class="stat-card-label">Events zur Freigabe</div>
      </div>
    </div>

    <div class="dashboard-grid">
      <div class="dashboard-main">
        <!-- Letzte Spiele -->
        <div class="card">
          <div class="card-header">
            <h2>Letzte Spiele</h2>
          </div>
          <% if (recentMatches.length === 0) { %>
            <div class="empty-state">Noch keine Spiele gecrawlt.</div>
          <% } else { %>
            <table class="data-table">
              <thead><tr><th>Datum</th><th>Heim</th><th>Gast</th><th>Ergebnis</th></tr></thead>
              <tbody>
                <% recentMatches.forEach(m => { %>
                  <tr>
                    <td><%= m.datum %></td>
                    <td><%= m.heim %></td>
                    <td><%= m.gast %></td>
                    <td>
                      <% if (m.ergebnis) { %>
                        <span class="match-score <%= m.kickpactTrigger?.sieg ? 'score-win' : m.kickpactTrigger?.niederlage ? 'score-loss' : 'score-draw' %>">
                          <%= m.ergebnis.heim %>:<%= m.ergebnis.gast %>
                        </span>
                      <% } else { %>-<% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <!-- Mannschaften Übersicht -->
        <div class="card">
          <div class="card-header">
            <h2>Mannschaften</h2>
            <a href="/club/mannschaften" class="link-more">Alle verwalten →</a>
          </div>
          <% if (teams.length === 0) { %>
            <div class="empty-state">
              <p>Noch keine Mannschaften.</p>
              <a href="/club/einstellungen" class="btn btn-sm btn-outline">Verein verknüpfen</a>
            </div>
          <% } else { %>
            <div class="teams-list">
              <% teams.forEach(t => { %>
                <a href="/club/mannschaft/<%= t._id %>" class="team-row">
                  <span class="team-row-name">👕 <%= t.name %></span>
                  <span class="team-row-meta">Saison <%= t.saison %></span>
                  <% if (t.lastCrawled) { %>
                    <span class="team-row-crawled">Crawled: <%= new Date(t.lastCrawled).toLocaleDateString('de-DE') %></span>
                  <% } %>
                  <span class="team-row-arrow">→</span>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div class="dashboard-sidebar">
        <div class="card">
          <h3 class="card-title-sm">Schnelllinks</h3>
          <div class="quick-links">
            <a href="/club/events/manuell" class="quick-link">📝 Manuelle Events</a>
            <a href="/club/sponsoren" class="quick-link">👥 Sponsoren</a>
            <a href="/club/statistiken" class="quick-link">📊 Statistiken</a>
            <a href="/club/einnahmen" class="quick-link">💰 Einnahmen</a>
            <a href="/club/quittungen" class="quick-link">📄 Quittungen</a>
            <a href="/club/einstellungen" class="quick-link">⚙️ Einstellungen</a>
          </div>
        </div>

        <% if (pendingEvents.length > 0) { %>
          <div class="card card-warning">
            <h3 class="card-title-sm">🔔 Freigabe ausstehend</h3>
            <% pendingEvents.forEach(ev => { %>
              <div class="pending-event-row">
                <strong><%= ev.typ %></strong> · <%= ev.spielerName || 'Unbekannt' %>
                <span class="pending-team"><%= ev.teamId?.name %></span>
              </div>
            <% }) %>
            <a href="/club/events/manuell" class="btn btn-outline btn-sm btn-full">Jetzt freigeben</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
