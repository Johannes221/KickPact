# Database
DATABASE_URL="postgresql://user:pass@host.neon.tech/kickpact?sslmode=require"

# Better Auth (Phase: Plan 2)
BETTER_AUTH_SECRET="generate via: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple "Sign in with Apple" — siehe docs/apple-sign-in-setup.md
# clientSecret wird zur Laufzeit aus den vier Werten unten als ES256-JWT signiert.
APPLE_CLIENT_ID=""        # Services-ID, z.B. "com.kickpact.web.auth"
APPLE_TEAM_ID=""          # 10-stelliger Team-Identifier (Apple Dev Portal → Membership)
APPLE_KEY_ID=""           # 10-stellige Key-ID des erzeugten "Sign in with Apple"-Keys
APPLE_PRIVATE_KEY=""      # Inhalt der .p8-Datei (Multiline ODER mit \n escaped)
APPLE_BUNDLE_ID=""        # optional: Native iOS-App Bundle-Identifier

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Stripe (Plan 5)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASIC_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# Resend (Plan 2)
# WICHTIG: MAIL_FROM muss eine verifizierte Domain bei Resend nutzen, sonst
# kann nur an die Account-Email gesendet werden (Sandbox-Limit).
RESEND_API_KEY=""
MAIL_FROM="KickPact <noreply@kickpact.com>"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
