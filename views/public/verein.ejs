<%- include('../partials/header', { title: club.name }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <div class="club-header">
      <h1 class="page-title">⚽ <%= club.name %></h1>
      <% if (club.isNonProfit) { %>
        <span class="badge badge-green">Gemeinnützig</span>
      <% } %>
      <p class="club-meta"><%= pledgeCount %> aktive Sponsoren</p>
    </div>

    <h2 class="section-heading">Mannschaften</h2>
    <% if (teams.length === 0) { %>
      <div class="empty-state">Noch keine Mannschaften eingetragen.</div>
    <% } else { %>
      <div class="cards-grid">
        <% teams.forEach(team => { %>
          <a href="/mannschaft/<%= team.slug %>" class="card card-link">
            <div class="card-icon">👕</div>
            <h3 class="card-title"><%= team.name %></h3>
            <p class="card-meta">Saison <%= team.saison.slice(0,2) %>/20<%= team.saison.slice(2) %></p>
            <span class="card-arrow">→</span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <div class="cta-box">
      <h3>Werde Sponsor für <%= club.name %>!</h3>
      <p>Unterstütze deine Lieblingsmannschaft mit performance-basiertem Sponsoring.</p>
      <a href="/registrieren" class="btn btn-primary">Jetzt Sponsor werden</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
