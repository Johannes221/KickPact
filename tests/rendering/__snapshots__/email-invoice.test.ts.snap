// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Invoice email — club copy > html snapshot 1`] = `"<!doctype html> <html><body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif; background:#F5F8F5; padding: 40px 20px; margin:0;"> <table style="max-width: 560px; margin: 0 auto; background:#fff; border-radius:14px; padding: 40px;"> <tr><td> <h1 style="font-size: 26px; margin: 0 0 4px; color:#1A1A2E; font-weight: 800;">KickPact</h1> <p style="color: #525252; margin: 0 0 28px; font-size: 14px;">Kopie zu deiner Rechnung an einen Sponsor</p> <h2 style="font-size: 20px; margin: 0 0 8px; color:#1A1A2E;">Hi Trainer Lukas,</h2> <p style="color: #1A1A2E; margin: 0 0 16px; line-height: 1.6;"> KickPact hat soeben eine Rechnung an <strong>Familie Müller</strong> verschickt. Die PDF liegt als Kopie im Anhang. </p> <table style="width:100%; background:#F5F8F5; border-radius:10px; padding: 18px; margin: 16px 0 24px;"> <tr><td style="color:#525252; font-size: 13px;">Rechnungsnummer</td><td style="text-align:right; font-weight: 600; color:#1A1A2E;">2026-05-001</td></tr> <tr><td style="color:#525252; font-size: 13px;">Zeitraum</td><td style="text-align:right; color:#1A1A2E;">Mai 2026</td></tr> <tr><td style="color:#525252; font-size: 13px;">Events</td><td style="text-align:right; color:#1A1A2E;">3</td></tr> <tr><td style="color:#525252; font-size: 13px;">Gesamt</td><td style="text-align:right; font-size: 18px; font-weight: 800; color:#01C457;">15,00 €</td></tr> </table> <p style="color:#525252; font-size: 14px; line-height: 1.6; margin: 0 0 24px;"> Sobald das Geld vom Sponsor eingegangen ist, kannst du die Rechnung im Dashboard unter Abrechnungen als <em>bezahlt</em> markieren. </p> <p style="color: #a3a3a3; font-size: 11px; margin-top: 36px; border-top: 1px solid #e5e5e5; padding-top: 16px;"> Verein: FC Sportfreunde 1910 Dossenheim<br/> Die Zahlung läuft direkt zwischen Sponsor und Verein — KickPact ist nur das Tool. </p> </td></tr> </table> </body></html>"`;

exports[`Invoice email — sponsor variant > html snapshot 1`] = `"<!doctype html> <html><body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif; background:#F5F8F5; padding: 40px 20px; margin:0;"> <table style="max-width: 560px; margin: 0 auto; background:#fff; border-radius:14px; padding: 40px;"> <tr><td> <h1 style="font-size: 26px; margin: 0 0 4px; color:#1A1A2E; font-weight: 800;">KickPact</h1> <p style="color: #525252; margin: 0 0 28px; font-size: 14px;">Performance-Sponsoring im Amateurfußball</p> <h2 style="font-size: 20px; margin: 0 0 8px; color:#1A1A2E;">Hi Familie Müller,</h2> <p style="color: #1A1A2E; margin: 0 0 16px; line-height: 1.6;"> deine Rechnung für <strong>Mai 2026</strong> ist da — 3 bestätigte Spielereignisse für <strong>FC Sportfreunde 1910 Dossenheim</strong>. </p> <table style="width:100%; background:#F5F8F5; border-radius:10px; padding: 18px; margin: 16px 0 24px;"> <tr><td style="color:#525252; font-size: 13px;">Gesamt</td><td style="text-align:right; font-size: 22px; font-weight: 800; color:#01C457;">15,00 €</td></tr> <tr><td colspan="2" style="font-size: 12px; color:#a3a3a3; padding-top: 8px;">Rechnungsnummer 2026-05-001</td></tr> </table> <p style="color:#525252; font-size: 14px; line-height: 1.6; margin: 0 0 24px;"> Die PDF findest du im Anhang. Bitte überweise den Betrag innerhalb von 14 Tagen an den Verein — Bankverbindung steht auf der Rechnung. </p> <p style="color:#1A1A2E; font-size: 14px; line-height: 1.6;"> Danke, dass du die Mannschaft unterstützt! 💚 </p> <p style="color: #a3a3a3; font-size: 11px; margin-top: 36px; border-top: 1px solid #e5e5e5; padding-top: 16px;"> KickPact bleibt zwischen Verein und Sponsor — wir leiten kein Geld weiter. Bezahlung direkt an den Verein. </p> </td></tr> </table> </body></html>"`;
