<%- include('../partials/header', { title: 'Statistiken' }) %>
<%- include('../partials/nav') %>

<main class="page-content">
  <div class="page-container">
    <h1 class="page-title">Saisonstatistiken</h1>

    <div class="team-selector-row">
      <label for="team-select">Mannschaft:</label>
      <select id="team-select" class="form-select" onchange="loadStats(this.value)">
        <option value="">Mannschaft wählen...</option>
        <% teams.forEach(t => { %>
          <option value="<%= t._id %>"><%= t.name %></option>
        <% }) %>
      </select>
    </div>

    <div id="stats-container" style="display:none">
      <div class="stats-row" id="stats-cards"></div>

      <div class="dashboard-grid">
        <div class="dashboard-main">
          <div class="card" id="torjaeger-card">
            <h2>🏅 Torjägerliste</h2>
            <div id="torjaeger-list"></div>
          </div>
        </div>
        <div class="dashboard-sidebar">
          <div class="card" id="sponsoring-card">
            <h2>💰 Sponsoring</h2>
            <div id="sponsoring-stats"></div>
          </div>
        </div>
      </div>
    </div>

    <div id="stats-loading" style="display:none" class="loading-state">Lade Statistiken...</div>
    <div id="stats-error" style="display:none" class="alert alert-error"></div>
  </div>
</main>

<script>
async function loadStats(teamId) {
  if (!teamId) return;
  document.getElementById('stats-container').style.display = 'none';
  document.getElementById('stats-loading').style.display = 'block';
  document.getElementById('stats-error').style.display = 'none';

  const res = await fetch(`/api/stats/team/${teamId}`);
  document.getElementById('stats-loading').style.display = 'none';

  if (!res.ok) {
    document.getElementById('stats-error').textContent = 'Fehler beim Laden der Statistiken.';
    document.getElementById('stats-error').style.display = 'block';
    return;
  }

  const s = await res.json();
  document.getElementById('stats-container').style.display = 'block';

  document.getElementById('stats-cards').innerHTML = `
    <div class="stat-card"><div class="stat-card-icon">🏟️</div><div class="stat-card-value">${s.spiele}</div><div class="stat-card-label">Spiele</div></div>
    <div class="stat-card stat-card-green"><div class="stat-card-icon">🏆</div><div class="stat-card-value">${s.siege}</div><div class="stat-card-label">Siege</div></div>
    <div class="stat-card"><div class="stat-card-icon">🤝</div><div class="stat-card-value">${s.unentschieden}</div><div class="stat-card-label">Unentschieden</div></div>
    <div class="stat-card stat-card-red"><div class="stat-card-icon">😔</div><div class="stat-card-value">${s.niederlagen}</div><div class="stat-card-label">Niederlagen</div></div>
    <div class="stat-card"><div class="stat-card-icon">⚽</div><div class="stat-card-value">${s.toreGeschosse}:${s.toreKassiert}</div><div class="stat-card-label">Tore</div></div>
    <div class="stat-card"><div class="stat-card-icon">🛡️</div><div class="stat-card-value">${s.zuNull}</div><div class="stat-card-label">Zu-Null</div></div>
    <div class="stat-card"><div class="stat-card-icon">🔥</div><div class="stat-card-value">${s.hattricks}</div><div class="stat-card-label">Hattricks</div></div>
  `;

  document.getElementById('torjaeger-list').innerHTML = s.torjaeger.length
    ? `<ol class="torjaeger-list">${s.torjaeger.map((t, i) => `
        <li class="torjaeger-item">
          <span class="torjaeger-rank">${i+1}.</span>
          <span class="torjaeger-name">${t.name}</span>
          <span class="torjaeger-goals">${t.tore} ⚽</span>
        </li>`).join('')}</ol>`
    : '<p class="text-muted">Keine Tordaten vorhanden.</p>';

  document.getElementById('sponsoring-stats').innerHTML = `
    <div class="detail-item"><label>Aktive Sponsoren</label><span>${s.pledgeCount}</span></div>
    <div class="detail-item"><label>Einnahmen (Netto)</label><span>${(s.einnahmenCent / 100).toFixed(2).replace('.', ',')}€</span></div>
    <div class="detail-item"><label>Ausstehend</label><span>${(s.ausstehendCent / 100).toFixed(2).replace('.', ',')}€</span></div>
  `;
}
</script>

<%- include('../partials/footer') %>
